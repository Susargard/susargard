---
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/manrope';
import '@fontsource-variable/caveat';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeBackground from '../components/ThemeBackground.astro';
import Decor from '../components/Decor.astro';
import { getSettings, withBase } from '../lib/content';
import { resolveTheme, type Theme, type ThemePreset } from '../lib/theme';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  theme?: Theme;
  fallbackPreset?: ThemePreset;
  noindex?: boolean;
  canonical?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image,
  theme,
  fallbackPreset = 'paper',
  noindex = false,
  canonical = true,
  jsonLd,
} = Astro.props;

const settings = await getSettings();
const resolved = resolveTheme(theme, fallbackPreset);

const pageTitle = title ? `${title} — ${settings.name}` : `${settings.name} — ${settings.role}`;
const pageDescription = description || settings.seoDescription;
const site = Astro.site ?? new URL('https://susargard.github.io');
const canonicalUrl = new URL(Astro.url.pathname, site);
const ogImage = new URL(image || settings.ogImage || withBase('/images/site/og-default.jpg'), site);

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: settings.name,
  alternateName: settings.alias,
  jobTitle: settings.role,
  description: settings.seoDescription,
  url: new URL(withBase('/'), site).href,
  address: settings.city
    ? {
        '@type': 'PostalAddress',
        addressLocality: settings.city,
        addressCountry: 'RU',
      }
    : undefined,
  sameAs: [settings.instagram, settings.behance, settings.telegram, settings.vk].filter(Boolean),
};
const structuredData = jsonLd ? [siteJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : siteJsonLd;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f0e6" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={`${settings.name} · ${settings.alias}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${settings.name} — ${settings.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body style={resolved.style} data-tone={resolved.tone}>
    <ThemeBackground image={resolved.backgroundImage} overlay={resolved.overlay} />
    <Decor decor={resolved.decor} />

    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <Header settings={settings} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>
