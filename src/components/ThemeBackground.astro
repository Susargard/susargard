---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  overlay?: number;
}

const { image, overlay = 0 } = Astro.props;
---

<div class="theme-bg" aria-hidden="true">
  {
    image && (
      <Image
        src={image}
        alt=""
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        loading="eager"
        decoding="async"
        class="theme-bg__image"
      />
    )
  }
  <div class="theme-bg__overlay" style={`opacity:${overlay / 100}`}></div>
  <div class="theme-bg__grain"></div>
</div>
