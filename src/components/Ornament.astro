---
interface Props {
  variant?: 'branch' | 'arch' | 'seed' | 'sun' | 'wave';
  class?: string;
}

const { variant = 'branch', class: className } = Astro.props;
---

<svg
  class:list={['ornament', className]}
  viewBox="0 0 200 260"
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    variant === 'branch' && (
      <>
        <path d="M100 248C98 196 94 143 88 96c-4-29-2-55 9-78" />
        <path d="M92 178c-22-2-39-13-48-31 20-4 38 4 48 31Z" />
        <path d="M98 148c19-6 30-19 33-38-20 2-32 15-33 38Z" />
        <path d="M88 118C66 118 50 108 42 89c20-4 37 5 46 29Z" />
        <path d="M94 85c16-8 24-22 23-40-18 5-26 19-23 40Z" />
        <path d="M100 63c-13-11-18-26-13-43 15 9 20 25 13 43Z" />
        <circle cx="100" cy="46" r="2.2" />
      </>
    )
  }
  {
    variant === 'arch' && (
      <>
        <path d="M28 246V128c0-41 32-74 72-74s72 33 72 74v118" />
        <path d="M52 246V132c0-28 22-51 48-51s48 23 48 51v114" />
        <path d="M100 80v-22" />
        <path d="M77 246v-89c0-14 10-25 23-25s23 11 23 25v89" />
        <path d="M28 158h144" />
        <path d="M18 246h164" />
        <path d="M45 110l8 9M155 110l-8 9" />
      </>
    )
  }
  {
    variant === 'seed' && (
      <>
        <circle cx="100" cy="118" r="44" />
        <circle cx="100" cy="118" r="12" />
        <path d="M100 74c10-18 26-27 46-28-3 20-17 35-36 40" />
        <path d="M100 162c-10 18-26 27-46 28 3-20 17-35 36-40" />
        <path d="M56 118c-18-10-27-26-28-46 20 3 35 17 40 36" />
        <path d="M144 118c18 10 27 26 28 46-20-3-35-17-40-36" />
        <path d="M100 74V38M100 162v36M56 118H20M144 118h36" />
      </>
    )
  }
  {
    variant === 'sun' && (
      <>
        <circle cx="100" cy="112" r="42" />
        <path d="M100 36V14M100 210v-22M24 112H6M194 112h-18M46 58 30 42M154 166l16 16M154 58l16-16M46 166l-16 16" />
        <path d="M78 116c8-11 14-16 22-16s14 5 22 16" />
        <path d="M84 138c10 8 22 8 32 0" />
      </>
    )
  }
  {
    variant === 'wave' && (
      <>
        <path d="M18 84c22-20 43-20 65 0s43 20 65 0 28-16 34-8" />
        <path d="M18 112c22-20 43-20 65 0s43 20 65 0 28-16 34-8" />
        <path d="M18 140c22-20 43-20 65 0s43 20 65 0 28-16 34-8" />
        <path d="M18 168c22-20 43-20 65 0s43 20 65 0 28-16 34-8" />
        <path d="M18 196c22-20 43-20 65 0s43 20 65 0 28-16 34-8" />
      </>
    )
  }
</svg>
