---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  caption?: string;
  title?: string;
}

const { before, after, caption, title = 'Сравнение до и после' } = Astro.props;
---

<section class="before-after-block" aria-labelledby="ba-title">
  <div class="gallery-block__head">
    <h2 id="ba-title" class="section-heading">До / после</h2>
    {caption && <span class="muted">{caption}</span>}
  </div>

  <div class="ba" role="group" aria-label={title}>
    <div class="ba__frame">
      <Image
        src={before}
        alt={`До: ${title}`}
        widths={[640, 1080, 1600]}
        sizes="(max-width: 900px) 92vw, 1100px"
        loading="lazy"
        decoding="async"
        class="ba__image ba__image--before"
      />
      <div class="ba__after">
        <Image
          src={after}
          alt={`После: ${title}`}
          widths={[640, 1080, 1600]}
          sizes="(max-width: 900px) 92vw, 1100px"
          loading="lazy"
          decoding="async"
          class="ba__image"
        />
      </div>
      <span class="ba__label ba__label--before">До</span>
      <span class="ba__label ba__label--after">После</span>
      <span class="ba__divider" aria-hidden="true"></span>
      <span class="ba__handle" aria-hidden="true">
        <span>←</span><span>→</span>
      </span>
      <input
        class="ba__range"
        type="range"
        min="0"
        max="100"
        value="50"
        step="0.5"
        aria-label="Сдвинуть границу сравнения «до / после»"
      />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.ba').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('.ba__range');
    if (!range) return;

    const update = () => root.style.setProperty('--ba-pos', `${range.value}%`);
    range.addEventListener('input', update);
    update();
  });
</script>
